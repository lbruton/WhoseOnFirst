# WhoseOnFirst Environment Configuration
# Copy this file to .env and fill in your values
# NEVER commit .env to version control

# ── Encryption Key (REQUIRED) ────────────────────────────
# REQUIRED — used for encrypting secrets at rest in the database (Twilio auth tokens, etc.)
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=

# ── Twilio (OPTIONAL — also configurable via Admin UI) ───
# OPTIONAL — Twilio credentials can also be configured via the Admin UI (preferred for first-time setup).
# If both env vars and DB settings are present, DB settings take precedence.
# Leaving these blank means SMS is unconfigured — send attempts will fail loudly. To enable mock sends for dev/testing, explicitly set SMS_MOCK_MODE=true below.
# Get these from https://console.twilio.com/
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# ── SMS Mock Mode (dev/testing only) ─────────────────────
# Set to true to log SMS instead of sending via Twilio
# SMS_MOCK_MODE=true

# ── Database ─────────────────────────────────────────────
# Default: SQLite at ./data/whoseonfirst.db
# DATABASE_URL=sqlite:///./data/whoseonfirst.db
# For PostgreSQL (future):
# DATABASE_URL=postgresql://user:pass@localhost:5432/whoseonfirst

# ── Security ─────────────────────────────────────────────
# Set to true in production (requires HTTPS)
# SECURE_COOKIES=true

# ── Debug ────────────────────────────────────────────────
# Enables SQL query logging (never use in production)
# DEBUG=true
