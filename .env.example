# WhoseOnFirst Environment Configuration
# Copy this file to .env and fill in your values
# NEVER commit .env to version control

# ── Twilio (required for SMS notifications) ──────────────
# Get these from https://console.twilio.com/
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_PHONE_NUMBER=+15551234567

# ── SMS Mock Mode (dev/testing only) ─────────────────────
# Set to true to log SMS instead of sending via Twilio
# SMS_MOCK_MODE=true

# ── Database ─────────────────────────────────────────────
# Default: SQLite at ./data/whoseonfirst.db
# DATABASE_URL=sqlite:///./data/whoseonfirst.db
# For PostgreSQL (future):
# DATABASE_URL=postgresql://user:pass@localhost:5432/whoseonfirst

# ── Security ─────────────────────────────────────────────
# Set to true in production (requires HTTPS)
# SECURE_COOKIES=true

# ── Debug ────────────────────────────────────────────────
# Enables SQL query logging (never use in production)
# DEBUG=true
